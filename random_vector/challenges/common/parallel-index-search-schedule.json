{
  "name": "delete-data-stream",
  "operation": {
    "operation-type": "delete-data-stream",
    "data-stream": [
      "vectors-benchmark-random"
    ]
  }
},
{
  "name": "delete-templates",
  "operation": {
    "operation-type": "delete-composable-template"
  }
},
{%- if dsl_rollover is defined %}
{
  "name":"update-settings",
  "operation": {
    "operation-type": "put-settings",
    "body": {
      "persistent": {
          "cluster.lifecycle.default.rollover": "{{ dsl_rollover | string }}"
      }
    }
  }
},
{%- endif %}
{
  "name": "create-templates",
  "operation": {
  "operation-type": "create-composable-template"
}
},
{
  "name": "check-cluster-health",
  "operation": "check-cluster-health"
},
{
  "parallel": {
    "warmup-time-period": {{ warmup_time_period | default(30) | int }},
    "time-period": {{ time_period | default(30) | int }},
    "tasks": [
      {
        "name": "random-indexing",
        "operation": "random-bulk-indexing",
        {%- if index_target_throughput is defined %}
        "target-throughput": {{ index_target_throughput | int }},
        {%- endif %}
        "clients": {{ index_clients | default(8) | int }},
        "warmup-time-period": {{ warmup_time_period | default(30) | int }},
        "time-period": {{ time_period | default(30) | int }},
        "looped": true
      },
      {
        "name": "brute-force-filtered-search",
        "operation": "brute-force-filtered-search",
        "clients": {{ search_clients | default(8) | int }},
        {%- if search_target_throughputs is defined %}
        "target-throughput": {{ search_target_throughput | int }},
        {%- endif %}
        "warmup-time-period": {{ warmup_time_period | default(30) | int }},
        "time-period": {{ time_period | default(30) | int }},
        "looped": true
      }
    ]
  }
}